DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=united_planners
JWT_SECRET=change_this_secret
PORT=4000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Copy this file to .env and fill in the values for your local MySQL instance.
# Replace the SMTP placeholders with your Gmail address and Google App Password.
# Then run: mysql -u root -p < database/schema.sql
